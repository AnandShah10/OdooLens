<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="report_sale_document" t-name="custom_sale.report_sale_document">
    <t t-call="web.html_container">
      <div class="page">
        <t t-field="doc.partner_id"/>
        <t t-esc="doc.amount_total"/>
        <span t-field="doc.x_nonexistent_field"/>
      </div>
    </t>
  </template>
  <record id="action_report_custom_sale" model="ir.actions.report">
    <field name="name">Custom Sale Report</field>
    <field name="model">sale.order</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">custom_sale.report_sale_document</field>
  </record>
</odoo>
