<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_bad_field" model="ir.ui.view">
        <field name="name">sale.order.form.bad.field</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <form string="Broken Standalone View">
                <field name="does_not_exist_field"/>
            </form>
        </field>
    </record>

    <record id="view_sale_order_form_bad_xpath" model="ir.ui.view">
        <field name="name">sale.order.form.bad.xpath</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="base_module.view_sale_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='does_not_exist']" position="after">
                <field name="priority"/>
            </xpath>
        </field>
    </record>
</odoo>
