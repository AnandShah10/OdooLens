<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_priority" model="ir.ui.view">
        <field name="name">sale.order.form.priority</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="base_module.view_sale_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="priority"/>
            </xpath>
        </field>
    </record>
</odoo>
