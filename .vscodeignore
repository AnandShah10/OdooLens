.vscode/**
.vscode-test/**
.github/**
src/**
tests/**
scratch/**
.gitignore
tsconfig.json
**/*.map
**/*.ts
node_modules/tree-sitter-wasms/out/*.wasm.map
# tree-sitter-wasms bundles ~35 language grammars; OdooLens only parses Python, so every other
# grammar is dead weight (this alone cuts the packaged extension from ~5MB to a few hundred KB).
# Keep this in sync with TreeSitterPython.ts if that ever loads an additional grammar.
node_modules/tree-sitter-wasms/out/*.wasm
!node_modules/tree-sitter-wasms/out/tree-sitter-python.wasm
.eslintrc*
eslint.config.js
out/tests/**
out/src/test/**
odoo-helper/**
